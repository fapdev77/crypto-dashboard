+});
+
+describe('getHedgeCoinSummaries', () => {
+  it('should roll up a hedge pair (short + long) on the same coin', () => {
+    const summaries = getHedgeCoinSummaries([SHORT_BTC, LONG_BTC], [BTC_BALANCE]);
